# Copy to backend/.env and fill in values. Never commit real values.

# Required. Postgres connection string (use the Neon dev branch locally).
DATABASE_URL=

# Required. Long random string used to sign and verify JWTs.
JWT_SECRET=

# Optional. OSRM base URL. Defaults to the public demo server.
OSRM_URL=

# Optional. development | test | production. Default development.
NODE_ENV=

# Optional. HTTP port. Default 5000.
PORT=5000

# Optional. Comma-separated list of allowed CORS origins.
CORS_ORIGINS=

# Optional. Firebase service account JSON on one line. Falls back to firebase-admin.json.
FIREBASE_SERVICE_ACCOUNT=

# Optional. GPS device failover tuning.
# Silence (ms) before a bus falls back from its GPS device to the driver's phone. Default 30000.
GPS_DEVICE_TIMEOUT_MS=
# Max age (ms) of the phone's last fix for it to be used as fallback. Default 30000.
GPS_MOBILE_FRESH_MS=
# Consecutive valid device fixes needed to switch back to the device. Default 3.
GPS_SWITCHBACK_COUNT=
# Valid device fixes needed before a device counts as verified. Default 3.
GPS_VERIFY_COUNT=
