# Copy to backend/.env and fill in values. Never commit real values.

# Required. Postgres connection string (use the Neon dev branch locally).
DATABASE_URL=

# Required. Long random string used to sign and verify JWTs.
JWT_SECRET=

# Optional. OSRM base URL. Defaults to the public demo server.
OSRM_URL=

# Optional. development | test | production. Default development.
NODE_ENV=

# Optional. HTTP port. Default 5000.
PORT=5000

# Optional. Comma-separated list of allowed CORS origins.
CORS_ORIGINS=

# Optional. Firebase service account JSON on one line. Falls back to firebase-admin.json.
FIREBASE_SERVICE_ACCOUNT=
